{
  "expo": {
    "name": "Examify",
    "slug": "examify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C47FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.examify.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Examify needs microphone access to record your speaking practice responses.",
        "NSSpeechRecognitionUsageDescription": "Examify uses speech recognition to score your speaking practice.",
        "NSCameraUsageDescription": "Examify uses your camera for profile photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C47FF"
      },
      "package": "com.examify.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C47FF"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Examify to access your microphone for speaking practice."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1d235b4f-580e-4e89-81e9-4a17fc32a870"
    },
    "extra": {
      "eas": {
        "projectId": "1d235b4f-580e-4e89-81e9-4a17fc32a870"
      }
    },
    "owner": "temmydtys"
  }
}
