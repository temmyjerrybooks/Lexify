# =============================================================
# EXAMIFY BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# Server
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Supabase (get from https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# JWT (Supabase handles this, but keep a secret for custom tokens)
JWT_SECRET=your-minimum-32-character-secret-here
JWT_EXPIRY=7d

# Groq API — primary key + up to 4 additional keys for round-robin rotation
# Get keys from https://console.groq.com
GROQ_API_KEY=gsk_your-primary-key-here
GROQ_API_KEY_2=gsk_your-second-key-here
GROQ_API_KEY_3=gsk_your-third-key-here
GROQ_API_KEY_4=gsk_your-fourth-key-here
GROQ_API_KEY_5=gsk_your-fifth-key-here

# App public URL (used in notification links and email templates)
APP_URL=https://your-production-domain.com

# Redis via Upstash (https://upstash.com — free tier available)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-key
REVENUECAT_SECRET_KEY=your-revenuecat-key

# OneSignal Push Notifications (https://onesignal.com)
ONESIGNAL_APP_ID=your-app-id
ONESIGNAL_API_KEY=your-api-key

# Storage
SUPABASE_STORAGE_BUCKET_AUDIO=exam-audio
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20

# Bull Queue (for async AI processing)
REDIS_URL=redis://localhost:6379

# CORS
ALLOWED_ORIGINS=http://localhost:8081,https://your-production-domain.com

# Logging
LOG_LEVEL=debug
